<%# locals: (client:) %>
<%# The client's Media tab: its library's folders at the top, how many files each holds, and the
    way into the full library (a record card, as the client's other tabs are). %>
<% library = Media::Library.new(client) %>
<% folders = library.folders_in(nil) %>
<%= record_card "Media", hint: "#{pluralize(library.documents.size, "file")} in #{pluralize(library.folders.size, "folder")}, wherever they’re kept.",
      action: ui(:button, href: media_library_path(client), variant: :outline, size: :sm, data: { turbo_frame: "_top" }, content: "Open the library") do %>
  <% if folders.any? %>
    <ul class="media-folders">
      <% folders.each do |folder| %>
        <%# herb:key folder.id %>
        <li>
          <%= render "media/libraries/folder", name: folder.name, path: media_library_path(client, folder: folder.id), frame: "_top", locked: folder.hidden?,
                meta: "#{media_folder_summary(library, folder)}#{" · kept from them" if folder.hidden?}" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= ui :empty, size: :sm, description: "No folders yet. Open the library to make some." %>
  <% end %>
<% end %>
