<% @page_title = @folder ? @folder.name : @client.name %>
<%= parent_page "Media", media_libraries_path %>
<% crumbs = @library.breadcrumbs(@folder) %>
<% locked = @folder&.locked? || false %>
<%# A client's library. Files are the core's Documents wherever they're kept; what's added here goes
    on the client. A locked folder keeps everything in it from the client's portal. %>
<%= render "media/libraries/nav", shelf: @shelf, client: @client, folder: @folder %>
<%# The open folder's (or the top's) folders and files, beside the folders in the sidebar (_nav). A
    file's tile opens its sheet; files drag onto a folder, here or in the sidebar, to move there. %>
<div class="media-library">
  <section class="media-library__main">
    <header class="media-library__head">
      <%= ui :breadcrumb, class: "media-crumbs", aria: { label: "Folder" },
            items: [ [ "Top", media_library_path(@client) ] ] + crumbs.map { [ it.name, media_library_path(@client, folder: it.id) ] } %>
      <% if @folder %>
        <div class="media-library__actions">
          <% if @folder.hidden? %>
            <%= ui :badge, variant: :secondary, content: safe_join([ icon_tag("lock"), "Kept from #{@client.name}" ], " ") %>
            <%= form_with url: media_folder_lock_path(@folder), method: :delete, class: "media-inline-form" do %>
              <%= ui :button, type: :submit, variant: :outline, size: :sm, title: "Files shared before it was locked are shared again", content: "Open to the #{term(:client).downcase}" %>
            <% end %>
          <% elsif locked %>
            <%= ui :badge, variant: :secondary, content: safe_join([ icon_tag("lock"), "Kept from #{@client.name} by a folder above" ], " ") %>
          <% else %>
            <%= form_with url: media_folder_lock_path(@folder), class: "media-inline-form" do %>
              <%= ui :button, type: :submit, variant: :outline, size: :sm, title: "Nothing in it reaches the #{term(:client).downcase}’s portal",
                    content: safe_join([ icon_tag("lock"), "Keep from the #{term(:client).downcase}" ], " ") %>
            <% end %>
          <% end %>
          <details class="media-library__rename">
            <summary class="ui-button" data-variant="ghost" data-size="sm"><%= icon_tag "pencil" %> Rename or move</summary>
            <%= form_with model: @folder, url: media_folder_path(@folder), method: :patch, scope: :folder, namespace: dom_id(@folder), class: "media-form" do |form| %>
              <%= form.ui :field, :name, label: "Name" do %>
                <%= form.ui :input, :name, required: true, autocomplete: "off", maxlength: 80 %>
              <% end %>
              <%= form.ui :field, :parent_id, label: "Inside" do %>
                <%= form.select :parent_id, media_folder_options(@library).reject { |_, id| id.to_s.present? && id.in?(@folder.subtree_ids) }, { selected: @folder.parent_id } %>
              <% end %>
              <div><%= ui :button, type: :submit, size: :sm, content: "Save" %></div>
            <% end %>
          </details>
          <% if @folder.empty? %>
            <%= render "layouts/shared/delete_dialog", name: @folder.name, path: media_folder_path(@folder), message: "The folder is empty, so nothing else goes with it." %>
          <% end %>
        </div>
      <% end %>
    </header>

    <%= render "media/libraries/search", filter: @filter, url: media_library_path(@client), keep: { folder: @folder&.id }, placeholder: "Search #{@client.name}’s files" %>
    <turbo-frame id="media_results" class="media-results" target="_top">
    <%= render "media/libraries/toolbar", filter: @filter, counts: @kind_counts, url: media_library_path(@client), keep: { folder: @folder&.id } %>

    <%# Files go straight to storage, then into this folder (or the top), on the client, internal. %>
    <%= form_with url: media_uploads_path, multipart: true, namespace: "media_upload", class: "document-drop", data: document_upload_data.merge(turbo_action: "advance") do |form| %>
      <%= hidden_field_tag :client_id, @client.id, id: nil %>
      <%= hidden_field_tag :folder_id, @folder&.id, id: nil %>
      <%= document_drop_target form %>
    <% end %>

    <%# Searching looks through the whole library: its folders by name, its files wherever they sit
        (each saying which folder). Otherwise it's the open folder's folders and files. A kind of
        file narrows the files and puts the folders away. %>
    <% if @filter.searching? %>
      <p class="media-section__more">Searching all of <%= @client.name %>’s library. <a href="<%= media_library_path(@client, folder: @folder&.id) %>">Clear</a></p>
    <% end %>
    <% if @folders.any? && @filter.kind.nil? %>
      <ul class="<%= class_names("media-folders", "media-folders--list": @filter.list?) %>">
        <% @folders.each do |folder| %>
          <%# herb:key folder.id %>
          <li data-filter-target="item">
            <%= render "media/libraries/folder", name: folder.name, path: media_library_path(@client, folder: folder.id), drop: folder.id, client_id: @client.id, locked: folder.hidden?,
                  meta: "#{media_folder_summary(@library, folder)}#{" · kept from the #{term(:client).downcase}" if folder.hidden?}" %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @files.any? %>
      <ul class="<%= class_names("media-files", "media-files--list": @filter.list?) %>">
        <% @files.each do |document| %>
          <%# herb:key document.id %>
          <% folder = @library.folder_of(document) if @filter.searching? %>
          <%= render "media/libraries/file", document: document, client_id: @client.id, locked: @library.locked?(document), place: (folder ? "In #{@library.breadcrumbs(folder).map(&:name).join(" / ")}" : ("At the top" if @filter.searching?)) %>
        <% end %>
      </ul>
    <% elsif @filter.narrowed? %>
      <%= render "layouts/shared/empty", text: "No files match. Try another search or kind.", action_text: "Show everything", action_path: media_library_path(@client, folder: @folder&.id) %>
    <% elsif @folders.none? %>
      <%= render "layouts/shared/empty", text: (@folder ? "Nothing in #{@folder.name} yet: drop files above." : "No files yet: drop some above, or add them on a #{term(:work).downcase} or #{term(:task).downcase}.") %>
    <% end %>
    </turbo-frame>
  </section>
</div>

<%= render "media/libraries/sheet", documents: @library.documents %>
