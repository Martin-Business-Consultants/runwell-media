<% @page_title = "Media" %>
<%# Every file in every active client's library, under a search, a pill per kind of file and grid
    or list; above them, each library as a folder (the business's own first), opened to browse its
    folders. A search finds libraries by name and files by name, title, alt text or caption. %>
<%= render "media/libraries/nav", shelf: @shelf %>
<div class="media-library">
  <%= render "media/libraries/search", filter: @filter, url: media_libraries_path, placeholder: "Search every #{term(:client).downcase}’s files" %>
  <turbo-frame id="media_results" class="media-results" target="_top">
  <%= render "media/libraries/toolbar", filter: @filter, counts: @kind_counts, url: media_libraries_path %>

  <% if @libraries.any? && @filter.kind.nil? %>
    <section class="media-section" aria-labelledby="media_libraries_heading">
      <h2 class="media-section__title" id="media_libraries_heading">Libraries</h2>
      <ul class="<%= class_names("media-folders", "media-folders--list": @filter.list?) %>">
        <% @libraries.each do |client| %>
          <%# herb:key client.id %>
          <li data-filter-target="item">
            <% files, folders = @file_counts.fetch(client.id, 0), @folder_counts.fetch(client.id, 0) %>
            <%= render "media/libraries/folder", name: client.name, path: media_library_path(client), home: client.internal?,
                  meta: [ pluralize(files, "file"), (pluralize(folders, "folder") if folders.positive?), ("your own" if client.internal?) ].compact.join(" · ") %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="media-section" aria-labelledby="media_files_heading">
    <h2 class="media-section__title" id="media_files_heading">
      <%= @filter.narrowed? ? "#{pluralize(@files.size, "file")} found" : "All files" %>
    </h2>
    <% if @files.any? %>
      <ul class="<%= class_names("media-files", "media-files--list": @filter.list?) %>">
        <% @files.first(Media::LibrariesController::FILE_LIMIT).each do |document| %>
          <%# herb:key document.id %>
          <%= render "media/libraries/file", document: document, locked: document.media_placement&.folder_id.in?(@locked_folder_ids), place: @library_of[document.id]&.name, client_id: @library_of[document.id]&.id %>
        <% end %>
      </ul>
      <% if @files.size > Media::LibrariesController::FILE_LIMIT %>
        <p class="media-section__more">The newest <%= Media::LibrariesController::FILE_LIMIT %> of <%= @files.size %>: search, pick a kind or open a library to see the rest.</p>
      <% end %>
    <% elsif @filter.narrowed? %>
      <%= render "layouts/shared/empty", text: "No files match. Try another search or kind.", action_text: "Show everything", action_path: media_libraries_path %>
    <% elsif @clients.none? %>
      <%= render "layouts/shared/empty", text: "No active #{term(:client, count: 2).downcase} yet." %>
    <% else %>
      <%= render "layouts/shared/empty", text: "No files yet: open a library to add some, or add them on a #{term(:work).downcase} or #{term(:task).downcase}." %>
    <% end %>
  </section>
  </turbo-frame>
</div>

<%= render "media/libraries/sheet", documents: @files.first(Media::LibrariesController::FILE_LIMIT) %>
