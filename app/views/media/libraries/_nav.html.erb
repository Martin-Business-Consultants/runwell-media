<%# locals: (shelf:, client: nil, folder: nil) %>
<%# The sidebar on every Media page (the core's section_nav, placed by the layout): All files, then
    every active library as a drop-down, its folders nested inside as drop-downs of their own, each
    with how many files it holds. The library and folders on screen start open and marked. Each is
    a drop target for its own library's files: one dragged onto it moves there (media--drop). %>
<% section_nav "Media" do %>
  <%= section_nav_link "All files", media_libraries_path, icon: "grid", current: client.nil? %>
  <%= section_nav_heading "Libraries" %>
  <% open_ids = shelf.open_ids(folder) %>
  <ul class="media-nav__list">
    <% shelf.clients.each do |library| %>
      <%# herb:key library.id %>
      <li>
        <details class="media-nav__branch"<% if library.id == client&.id %> open<% end %>>
          <summary class="media-nav__summary">
            <span class="media-nav__toggle" aria-hidden="true"><%= icon_tag "caret-down" %></span>
            <a href="<%= media_library_path(library) %>" class="media-nav__link"<% if library.id == client&.id && folder.nil? %> aria-current="page"<% end %> data-controller="media--drop" data-media--drop-url-value="<%= media_document_move_path("__id__") %>" data-media--drop-folder-value="" data-media--drop-client-value="<%= library.id %>" data-action="dragover->media--drop#over dragleave->media--drop#leave drop->media--drop#drop">
              <% if library.internal? %>
                <%= icon_tag "home" %>
              <% else %>
                <%= media_icon :folder %>
              <% end %>
              <span class="media-nav__name"><%= library.name %></span><span class="media-nav__count"><%= shelf.total_for(library) %></span>
            </a>
          </summary>
          <%= render "media/libraries/tree", shelf: shelf, client: library, parent: nil, current: folder, open_ids: open_ids %>
          <% if library.id == client&.id %>
            <details class="media-nav__new">
              <summary class="media-nav__link media-nav__add"><%= icon_tag "add" %><span class="media-nav__name">New folder</span></summary>
              <%= form_with url: media_folders_path(client_id: library.id), scope: :folder, namespace: "new_media_folder", class: "media-nav__form" do |form| %>
                <%= form.hidden_field :parent_id, value: folder&.id %>
                <%= form.ui :input, :name, required: true, autocomplete: "off", placeholder: "Folder name", maxlength: 80, aria: { label: "Folder name" } %>
                <p class="media-nav__hint">Inside <%= folder ? folder.name : "the top of the library" %>.</p>
                <div><%= ui :button, type: :submit, size: :sm, content: "Add folder" %></div>
              <% end %>
            </details>
          <% end %>
        </details>
      </li>
    <% end %>
  </ul>
<% end %>
