<%# locals: (shelf:, client:, parent:, current:, open_ids:) %>
<%# The folders inside parent (nil: the library's top), nested. One with folders inside is a
    drop-down, open when the folder on screen is in it; one without is a plain row. %>
<% folders = shelf.folders_in(client, parent) %>
<% if folders.any? %>
  <ul class="media-nav__list media-nav__list--nested">
    <% folders.each do |folder| %>
      <%# herb:key folder.id %>
      <li>
        <% if shelf.folders_in(client, folder).any? %>
          <details class="media-nav__branch"<% if open_ids.include?(folder.id) %> open<% end %>>
            <summary class="media-nav__summary">
              <span class="media-nav__toggle" aria-hidden="true"><%= icon_tag "caret-down" %></span>
              <%= render "media/libraries/nav_folder", shelf: shelf, client: client, folder: folder, current: current %>
            </summary>
            <%= render "media/libraries/tree", shelf: shelf, client: client, parent: folder, current: current, open_ids: open_ids %>
          </details>
        <% else %>
          <div class="media-nav__summary">
            <span class="media-nav__toggle" aria-hidden="true"></span>
            <%= render "media/libraries/nav_folder", shelf: shelf, client: client, folder: folder, current: current %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
