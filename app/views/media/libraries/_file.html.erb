<%# locals: (document:, library:, locked:) %>
<%# One file as a tile: a preview (an image itself, else its type), its name opening it, what it
    is and where it's kept, whether the client sees it (the core's switch, off and fixed while its
    folder is locked), and moving or deleting it. %>
<li class="media-file" id="<%= dom_id(document, :media) %>" data-filter-target="item">
  <%= link_to media_file_url(document), class: "media-file__preview", target: "_blank", rel: "noopener" do %>
    <% if media_image?(document) %>
      <img src="<%= media_file_url(document) %>" alt="" loading="lazy" class="media-file__image">
    <% else %>
      <span class="media-file__type"><%= document.filename.extension&.downcase.presence || "file" %></span>
    <% end %>
  <% end %>
  <div class="media-file__body">
    <%= link_to document.filename.to_s, media_file_url(document), class: "media-file__name", target: "_blank", rel: "noopener", title: document.filename.to_s %>
    <p class="media-file__meta"><%= [ number_to_human_size(document.byte_size), media_origin(document) ].compact.join(" · ") %></p>
    <div class="media-file__actions">
      <% if locked %>
        <span class="badge" title="In a folder kept from the client">Internal</span>
      <% else %>
        <%= form_with model: document, namespace: dom_id(document, :media), class: "media-file__share", data: { controller: "form" } do |form| %>
          <%= switch_tag(title: "Visible to the client", screen_reader_label: "Visible to the client") { form.check_box :client_visible, role: "switch", data: { action: "change->form#submit" } } %>
        <% end %>
      <% end %>
      <details class="media-file__move">
        <summary class="icon-button" title="Move to another folder"><%= icon_tag "move" %></summary>
        <%= form_with url: media_document_move_path(document), namespace: dom_id(document, :move), class: "media-file__move-form" do |form| %>
          <%= form.select :folder_id, media_folder_options(library), { selected: document.media_placement&.folder_id }, class: "select--sm", aria: { label: "Move to" } %>
          <button type="submit" class="btn btn--secondary btn--sm">Move</button>
        <% end %>
      </details>
      <% if document.deletable_by?(Current.user) %>
        <%= render "layouts/shared/delete_dialog", name: document.filename.to_s, path: document_path(document),
              message: "The file is removed for everyone, including the client’s portal and the record it’s kept on." %>
      <% end %>
    </div>
  </div>
</li>
