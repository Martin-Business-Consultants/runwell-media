<%# locals: (document:, locked:, client_id:, place: nil) %>
<%# One file as a tile (or a row, in .media-files--list): a preview (an image itself, else its
    type), its title, what it is and where it's kept (place: whose library or which folder, where
    files from several are shown together), and whether the client sees it. Clicking opens its sheet (its details, sharing,
    folder); dragging it onto a folder moves it there (media--drag). %>
<li class="media-file" id="<%= dom_id(document, :media) %>" data-filter-target="item" draggable="true"
  data-controller="media--drag" data-media--drag-id-value="<%= document.id %>" data-media--drag-client-value="<%= client_id %>" data-action="dragstart->media--drag#start dragend->media--drag#end">
  <a href="<%= media_asset_path(document) %>" class="media-file__open" draggable="false" data-turbo-frame="media_sheet" aria-label="Open <%= document.media_title %>">
    <span class="media-file__preview">
      <% if media_image?(document) %>
        <img src="<%= media_file_url(document) %>" alt="<%= document.media_asset&.alt_text %>" loading="lazy" class="media-file__image" draggable="false">
      <% else %>
        <span class="media-file__type"><%= document.filename.extension&.downcase.presence || "file" %></span>
      <% end %>
    </span>
    <span class="media-file__body">
      <span class="media-file__name" title="<%= document.filename %>"><%= document.media_title %></span>
      <span class="media-file__meta"><%= [ number_to_human_size(document.byte_size), place, media_origin(document) ].compact.join(" · ") %></span>
    </span>
  </a>
  <span class="media-file__badges">
    <% if locked %>
      <%= ui :badge, variant: :secondary, title: "In a folder kept from the client", aria: { label: "Kept from the client" }, content: icon_tag("lock") %>
    <% elsif document.client_visible? %>
      <%= ui :badge, variant: :success, title: "The client sees it in their portal", content: "Shared" %>
    <% end %>
    <% if media_image?(document) && document.media_asset&.alt_text.blank? %>
      <%= ui :badge, variant: :outline, title: "No alt text yet: open it to add some", content: "No alt" %>
    <% end %>
  </span>
</li>
