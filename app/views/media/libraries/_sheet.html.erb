<%# locals: (documents:) %>
<%# The file sheet: runeui's drawer from the right, holding a frame a file's tile loads it into
    (Media::AssetsController#show); the media--sheet controller opens it when the file arrives and
    empties it when it closes (Esc, the ✕, a press outside). ?asset= on the address opens it on load
    (documents: the files this page shows, the only ones it opens). %>
<% open_asset = documents.find { it.id.to_s == params[:asset].to_s } if params[:asset].present? %>
<%= ui :drawer, id: "media_sheet_drawer", size: :lg, class: "media-sheet-drawer", data: { controller: "media--sheet", action: "turbo:frame-load->media--sheet#loaded openchangecomplete->media--sheet#settled" } do %>
  <turbo-frame id="media_sheet" target="_top"<% if open_asset %> src="<%= media_asset_path(open_asset) %>"<% end %>></turbo-frame>
<% end %>
