<% @page_title = @folder ? @folder.name : media_portal_name %>
<% crumbs = @library.breadcrumbs(@folder) %>
<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">Files we’ve shared with you, in their folders.</p>
<% end %>

<%# What's shared with the client, in the folders not kept from them (Media::Library.for_client). %>
<% if @folder %>
  <%= ui :breadcrumb, class: "media-crumbs", aria: { label: "Folder" },
        items: [ [ media_portal_name, media_portal_library_path ] ] + crumbs.map { [ it.name, media_portal_library_path(folder: it.id) ] } %>
<% end %>

<% folders = @library.folders_in(@folder).select { @library.shown?(it) } %>
<% files = @library.documents_in(@folder) %>
<% if folders.any? %>
  <ul class="media-folders">
    <% folders.each do |folder| %>
      <%# herb:key folder.id %>
      <li>
        <%= render "media/libraries/folder", name: folder.name, path: media_portal_library_path(folder: folder.id), meta: pluralize(@library.count_in(folder), "file") %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if files.any? %>
  <ul class="media-files">
    <% files.each do |document| %>
      <%# herb:key document.id %>
      <li class="media-file">
        <a href="<%= media_file_url(document) %>" class="media-file__preview" target="_blank" rel="noopener">
          <% if media_image?(document) %>
            <img src="<%= media_file_url(document) %>" alt="<%= document.media_asset&.alt_text %>" loading="lazy" class="media-file__image">
          <% else %>
            <span class="media-file__type"><%= document.filename.extension&.downcase.presence || "file" %></span>
          <% end %>
        </a>
        <div class="media-file__body">
          <a href="<%= media_file_url(document, download: true) %>" class="media-file__name" title="Download <%= document.filename %>"><%= document.media_title %></a>
          <% if document.media_asset&.caption.present? %>
            <p class="media-file__caption"><%= document.media_asset.caption %></p>
          <% end %>
          <p class="media-file__meta"><%= [ number_to_human_size(document.byte_size), l(document.created_at.in_time_zone.to_date, format: :short), document.media_asset&.credit ].compact.join(" · ") %></p>
        </div>
      </li>
    <% end %>
  </ul>
<% elsif folders.none? %>
  <%= render "layouts/shared/empty", text: (@folder ? "Nothing shared in #{@folder.name} yet." : "Nothing shared with you yet.") %>
<% end %>
